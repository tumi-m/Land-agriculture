# Live advert feed. Any JSON endpoint returning { revision, updatedAt, listings[] }.
# With no feed the site shows its reference content and no listings — it never invents one.
LAND_DATA_URL=

# Optional bearer token sent with the feed request.
LAND_DATA_TOKEN=

# Shared secret for POST /api/revalidate. Without it the webhook returns 501.
REVALIDATE_SECRET=
