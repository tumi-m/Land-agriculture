{
  "nodes": {
    "maplibre-worker": {
      "description": "MapLibre worker to public/maplibre/",
      "command": ["node", "scripts/maplibre-worker.mjs"],
      "inputs": ["scripts/maplibre-worker.mjs", "node_modules/maplibre-gl/package.json"],
      "outputs": [
        "public/maplibre/maplibre-gl-worker.mjs",
        "public/maplibre/maplibre-gl-shared.mjs",
        "public/maplibre/version.json"
      ]
    },
    "build-topo": {
      "description": "District boundaries to src/data/sa-districts.topo.json",
      "command": ["node", "scripts/build-topo.mjs", "0.05"],
      "inputs": ["scripts/build-topo.mjs"],
      "outputs": ["src/data/sa-districts.topo.json"]
    },
    "build-dem": {
      "description": "Terrain tiles to public/data/sa-dem.png + .json",
      "command": ["node", "scripts/build-dem.mjs", "720"],
      "inputs": ["scripts/build-dem.mjs"],
      "outputs": ["public/data/sa-dem.png", "public/data/sa-dem.json"]
    },
    "bake-rasters": {
      "description": "Land cover, rain and soil grids to public/data/layers/",
      "command": ["node", "scripts/data/bake-rasters.mjs"],
      "inputs": [
        "scripts/data/bake-rasters.mjs",
        "scripts/data/sources.json",
        "scripts/data/raster-colors.json",
        "public/data/sa-dem.png",
        "public/data/sa-dem.json"
      ],
      "outputs": [
        "public/data/layers/landcover.values.png",
        "public/data/layers/landcover.color.png",
        "public/data/layers/landcover.json",
        "public/data/layers/rain.values.png",
        "public/data/layers/rain.color.png",
        "public/data/layers/rain.json",
        "public/data/layers/soil-ph.values.png",
        "public/data/layers/soil-ph.color.png",
        "public/data/layers/soil-ph.json",
        "public/data/layers/soil-clay.values.png",
        "public/data/layers/soil-clay.color.png",
        "public/data/layers/soil-clay.json",
        "public/data/layers/hillshade.values.png",
        "public/data/layers/hillshade.color.png",
        "public/data/layers/hillshade.json"
      ]
    },
    "district-stats": {
      "description": "District statistics to src/data/district-stats.json",
      "command": ["node", "scripts/data/district-stats.mjs"],
      "inputs": [
        "scripts/data/district-stats.mjs",
        "src/data/sa-districts.topo.json",
        "src/data/notice-parcels.json",
        "src/data/nc-district-evidence.json",
        "src/content/farm-notices.ts",
        "src/content/northern-cape-notices.json",
        "src/content/notices-2026.json",
        "src/content/notice-coverage.json",
        "public/data/sa-dem.png",
        "public/data/sa-dem.json",
        "public/data/layers/rain.json",
        "public/data/layers/rain.values.png",
        "public/data/layers/landcover.json",
        "public/data/layers/landcover.values.png",
        "public/data/layers/soil-ph.json",
        "public/data/layers/soil-ph.values.png",
        "public/data/layers/soil-clay.json",
        "public/data/layers/soil-clay.values.png",
        "public/data/layers/hillshade.json"
      ],
      "outputs": ["src/data/district-stats.json"]
    }
  },
  "edges": [
    { "from": "build-dem", "to": "bake-rasters" },
    { "from": "build-topo", "to": "district-stats" },
    { "from": "bake-rasters", "to": "district-stats" }
  ]
}
