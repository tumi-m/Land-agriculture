{
  "name": "asbonge-studio",
  "private": true,
  "description": "Motion studio for the Land Locator: films, explainers, title cards and sound, kept out of the web app's build.",
  "type": "module",
  "scripts": {
    "brief": "tsx --tsconfig tsconfig.json scripts/brief.ts",
    "design": "tsx --tsconfig tsconfig.json scripts/design.tsx",
    "sound": "tsx --tsconfig tsconfig.json scripts/sound.ts",
    "studio": "remotion studio src/index.ts",
    "render": "tsx --tsconfig tsconfig.json scripts/render.ts",
    "review": "tsx --tsconfig tsconfig.json scripts/review.ts",
    "ship": "tsx --tsconfig tsconfig.json scripts/ship.ts",
    "loop": "npm run brief && npm run design && npm run sound && npm run render && npm run review && npm run ship",
    "explainer": "vite --config explainers/vite.config.ts",
    "explainer:render": "tsx --tsconfig tsconfig.json scripts/explainer.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p explainers"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@lottiefiles/dotlottie-web": "0.81.0",
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@motion-canvas/ffmpeg": "3.17.2",
    "@motion-canvas/ui": "3.17.2",
    "@motion-canvas/vite-plugin": "3.17.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.2.0",
    "@react-three/rapier": "2.2.0",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/three": "4.0.535",
    "@resvg/resvg-js": "2.6.2",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "gsap": "3.15.0",
    "mediabunny": "1.60.0",
    "playwright-core": "1.63.0",
    "postprocessing": "6.39.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.535",
    "satori": "0.56.1",
    "svgo": "4.1.0",
    "three": "0.171.0",
    "tsx": "4.23.15",
    "vite": "5.4.21"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.171.0",
    "typescript": "5.9.3"
  }
}
