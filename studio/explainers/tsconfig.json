{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@motion-canvas/2d/lib",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@motion-canvas/core/project", "node"],
    "paths": { "@/*": ["../../src/*"] }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
